<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Decrement Technician Active Daily Workload.</description>
        <name>Technician_Workload_Decrement</name>
        <label>Technician Workload Decrement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Technician_of_this_Repair_Request.Active_Daily_Workload__c</assignToReference>
            <operator>Subtract</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decrementing_workload</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Update Last Repaired done using this warranty for the respective Product.</description>
        <name>Update_Last_Repair_Date_on_Warranty</name>
        <label>Update Last Repair Date on Warranty</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Warranty_for_this_Repair_Request.Last_Repair_date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Putting_Last_Repair_Date_on_Warranty</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_Warranty_Exist</name>
        <label>Any Warranty Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Warranty</defaultConnectorLabel>
        <rules>
            <name>Warranty_Exist_for_repair_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Warranty__r</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Warranty_for_this_Repair_Request</targetReference>
            </connector>
            <label>Warranty Exist for repair request</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Workload_of_Technician_Positive</name>
        <label>Is Workload of Technician Positive</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Any_Warranty_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Workload already Zero</defaultConnectorLabel>
        <rules>
            <name>Workload_more_than_Zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Technician__r.Active_Daily_Workload__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Technician_of_this_Repair_Request</targetReference>
            </connector>
            <label>Workload more  than Zero</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Stamp Resolution Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Changes on Resolved Repair Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Technician_of_this_Repair_Request</name>
        <label>Get Technician of this Repair Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Technician_Workload_Decrement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Technician__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Technician__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Warranty_for_this_Repair_Request</name>
        <label>Get Warranty for this Repair Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Last_Repair_Date_on_Warranty</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Warranty__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Warranty__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Decrementing_workload</name>
        <label>Decrementing workload</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Any_Warranty_Exist</targetReference>
        </connector>
        <inputReference>Get_Technician_of_this_Repair_Request</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Putting_Last_Repair_Date_on_Warranty</name>
        <label>Putting Last Repair Date on Warranty</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Warranty_for_this_Repair_Request</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_resolution_Date_Time</name>
        <label>Update resolution Date/Time</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Workload_of_Technician_Positive</targetReference>
        </connector>
        <inputAssignments>
            <field>Resolution_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_resolution_Date_Time</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Technician__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Repair_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Resolved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Resolution_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Repair_Request__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
