<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increase_Technician_Workload</name>
        <label>Increase Technician Workload</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SelectedTechnician.Active_Daily_Workload__c</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Technician</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>store_found_territory</name>
        <label>store found territory</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SelectedTerritory</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Territory</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Candidate_Technicians</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_Selected_Technician</name>
        <label>Store Selected Technician</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SelectedTechnician</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Evaluate_Candidate_Technicians</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TechnicianFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Evaluate_Candidate_Technicians</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Capacity_Available</name>
        <label>Has Capacity Available?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Evaluate_Candidate_Technicians</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Capacity_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Evaluate_Candidate_Technicians.Is_Capacity_Available__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Specialization_Matches</targetReference>
            </connector>
            <label>Capacity Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Specialization_Matches</name>
        <label>Specialization Matches?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Evaluate_Candidate_Technicians</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Matched</defaultConnectorLabel>
        <rules>
            <name>Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Evaluate_Candidate_Technicians.Specialization__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Issue_Category__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Store_Selected_Technician</targetReference>
            </connector>
            <label>Matched</label>
        </rules>
    </decisions>
    <decisions>
        <name>Technician_Already_Selected</name>
        <label>Technician Already Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Capacity_Available</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue Evaluation</defaultConnectorLabel>
        <rules>
            <name>Technician_Is_Already_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TechnicianFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Evaluate_Candidate_Technicians</targetReference>
            </connector>
            <label>Technician Is Already Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Technician_Found</name>
        <label>Technician Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TechnicianFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increase_Technician_Workload</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Technician Assignment Engine {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Technician Assignment Engine</label>
    <loops>
        <name>Evaluate_Candidate_Technicians</name>
        <label>Evaluate Candidate Technicians</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Candidate_Technicians</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Technician_Already_Selected</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Technician_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Search for the territory based on service zip code on repair request</description>
        <name>Find_Territory</name>
        <label>Find Territory</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>store_found_territory</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Zip_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Service_Zip_Code__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Territory__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the technician based on the territory we found</description>
        <name>Get_Candidate_Technicians</name>
        <label>Get Candidate Technicians</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Candidate_Technicians</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Territory__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Find_Territory.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Technician__c</object>
        <sortField>Active_Daily_Workload__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Repair_Request</name>
        <label>Update Repair Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Repair_Status__c</field>
            <value>
                <stringValue>Assigned</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Technician__c</field>
            <value>
                <elementReference>SelectedTechnician.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Territory__c</field>
            <value>
                <elementReference>SelectedTerritory.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Technician</name>
        <label>Update Technician</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Repair_Request</targetReference>
        </connector>
        <inputReference>SelectedTechnician</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Territory</targetReference>
        </connector>
        <object>Repair_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>this temporary stores the difference between max capacity and daily capacity</description>
        <name>RemainingCapacity</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>Stores the final technician object selected after looping</description>
        <name>SelectedTechnician</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Technician__c</objectType>
    </variables>
    <variables>
        <description>Stores the final territory object selected after finding it with service zipcode</description>
        <name>SelectedTerritory</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Territory__c</objectType>
    </variables>
    <variables>
        <description>Check if the loop end up giving a technician</description>
        <name>TechnicianFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
